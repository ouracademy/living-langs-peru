# Machine-local settings that the tooling rewrites. Git ignores this file
# globally, so Prettier failing on it would only ever fail on a laptop.
.claude/settings.local.json

# Baselines written by ESLint (--suppress-all / --prune-suppressions) and
# dependency-cruiser (depcruise-baseline) in their own format; they rewrite
# them on every prune, so formatting them would only churn.
eslint-suppressions.json
.dependency-cruiser-known-violations.json

# Other git worktrees (other branches).
.claude/worktrees

