# The fast tier of CONSTRAINTS.md before anything leaves the laptop: types,
# lint, the floor and the language policy. ~5s. CI runs the rest.
#
# Load nvm if it is around, so the hook does not fail just because the shell
# git was launched from had an older Node than .nvmrc (see the commit-msg hook).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
  nvm use >/dev/null 2>&1 || true
fi

major="$(node -v | sed 's/^v//' | cut -d. -f1)"
if [ "$major" -lt 22 ]; then
  echo "pre-push hook: Node >= 22 required, got $(node -v). Run 'nvm use' (see .nvmrc)."
  exit 1
fi

pnpm check:fast
