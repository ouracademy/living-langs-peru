# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Other git worktrees made by Claude Code (other branches). Without this,
# `git status` is never clean and the Stop hook always runs.
/.claude/worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Saltapalabras pack drafts (pnpm pack:draft): reviewed and published at
# /admin/juego, the database keeps the history, never the repo.
paquete-*-borrador.json
paquete-*-verificado.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
